<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. The WebView's data (cookies, so the forum session) is never backed up or transferred (SPEC §3). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_webview" />
        <exclude domain="file" path="image_cache" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_webview" />
        <exclude domain="file" path="image_cache" />
    </device-transfer>
</data-extraction-rules>
