<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower. The WebView's data (cookies, so the forum session) and caches are never backed up (SPEC §3). -->
<full-backup-content>
    <exclude domain="root" path="app_webview" />
    <exclude domain="file" path="image_cache" />
    <!-- Saved pages hold other members' posts: they stay on this phone (SPEC §7). Settings export covers the rest. -->
    <exclude domain="database" path="muabet.db" />
    <exclude domain="database" path="muabet.db-wal" />
    <exclude domain="database" path="muabet.db-shm" />
</full-backup-content>
